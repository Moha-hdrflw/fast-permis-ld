---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Fast Permis – Auto-école Roubaix | Permis dès 699€",
  description = "Fast Permis, auto-école à Roubaix. Permis boîte automatique dès 699€ ou manuelle dès 990€. Paiement 3x sans frais. Dates d'examen rapides. Réserve ton appel gratuit.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- META PIXEL CODE + EMQ FIXES -->
    <script>
      // ── Helpers ──────────────────────────────────────────────
      function getCookie(name) {
        const m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
        return m ? decodeURIComponent(m[1]) : null;
      }

      function setCookie(name, value, days) {
        const exp = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = name + '=' + encodeURIComponent(value) +
          '; expires=' + exp + '; path=/; SameSite=Lax';
      }

      // fbc : construit depuis fbclid si présent dans l'URL, sinon cookie existant
      function getFbc() {
        const params = new URLSearchParams(window.location.search);
        const fbclid = params.get('fbclid');
        if (fbclid) {
          const fbc = 'fb.1.' + Date.now() + '.' + fbclid;
          setCookie('_fbc', fbc, 90);
          return fbc;
        }
        return getCookie('_fbc');
      }

      // fbp : cookie déposé automatiquement par le pixel
      function getFbp() { return getCookie('_fbp'); }

      // external_id : ID de session persistant par navigateur
      function getExternalId() {
        let id = localStorage.getItem('_fp_eid');
        if (!id) {
          id = (crypto.randomUUID ? crypto.randomUUID()
            : Math.random().toString(36).slice(2) + Date.now().toString(36));
          localStorage.setItem('_fp_eid', id);
        }
        return id;
      }

      // ── Init Pixel avec external_id ───────────────────────────
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');

      fbq('init', '2347878375704800', { external_id: getExternalId() });
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2347878375704800&ev=PageView&noscript=1"/>
    </noscript>
  </head>
  <body>
    <!-- Neon background FX -->
    <div class="neon-bg" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="beam beam-1"></div>
      <div class="beam beam-2"></div>
    </div>

    <slot />

    <!-- Scroll animations -->
    <script>
      const fadeEls = document.querySelectorAll('.fade-up:not(.visible)');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      fadeEls.forEach(el => observer.observe(el));
    </script>

    <!-- Tracking clics Calendly → Pixel + CAPI (dédoublonnage par eventId) -->
    <script>
      document.querySelectorAll('a[href*="calendly.com"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const fbp        = getFbp();
          const fbc        = getFbc();
          const externalId = getExternalId();

          // eventId identique côté client ET serveur → Meta dédoublonne automatiquement
          const eventId = externalId + '_lead_' + Date.now();

          // 1. Pixel navigateur
          if (typeof fbq !== 'undefined') {
            fbq('track', 'Lead', {}, { eventID: eventId });
          }

          // 2. CAPI côté serveur (améliore l'EMQ avec IP réelle + user-agent)
          fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              eventId,
              externalId,
              sourceUrl:  window.location.href,
              userAgent:  navigator.userAgent,
              fbp:        fbp  || '',
              fbc:        fbc  || '',
            }),
          }).catch(() => {});
        });
      });
    </script>
  </body>
</html>
