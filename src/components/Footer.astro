---
import type { Agence } from '../data/agences';

interface Props { agence: Agence }
const { agence } = Astro.props;
---

<footer>
  <div class="footer-logo">
    <img src="/logo.webp" alt="Fast Permis" width="48" height="48" loading="lazy" />
  </div>
  <p class="footer-copy">© 2026 Fast Permis – Auto-école à {agence.ville}</p>
  <p class="footer-copy" style="margin-top:6px; font-size:0.76rem;">
    {agence.adresse && <>{agence.adresse} · </>}
    <a href="mailto:contact@fastpermis591.com">contact@fastpermis591.com</a>
  </p>
</footer>

<style>
  footer {
    background: var(--black);
    border-top: 1px solid var(--border);
    padding: 32px 24px;
    text-align: center;
  }

  .footer-logo { margin-bottom: 10px; }
  .footer-logo img { height: 48px; width: auto; object-fit: contain; }

  .footer-copy { font-size: 0.83rem; color: var(--text-muted); }

  footer a {
    color: var(--text-muted);
    text-decoration: underline;
  }
  footer a:hover { color: var(--white); }
</style>
