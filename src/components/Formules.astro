---
import type { Agence } from '../data/agences';

interface Props { prix: Agence['prix']; remise?: number; ville: string }
const { prix, remise, ville } = Astro.props;
const CALENDLY = "https://calendly.com/fastpermis-rdv/30min?month=2026-04";

const en3x = (p: number) =>
  `Paiement en 3x = ${(p / 3).toFixed(2).replace('.00', '').replace('.', ',')}€/mois`;

const formules = [
  {
    popular: true,
    name: "Boîte Automatique",
    price: prix.auto,
    subPrice: en3x(prix.auto),
    features: [
      "13h de conduite",
      "Révision du code de la route offerte (en ligne)",
      "Dates d'examen rapides",
      "Paiement en 3x sans frais via Alma",
      "Accompagnement du début à la fin",
    ],
    cta: "Je réserve — Boîte Auto →",
    highlight: false,
  },
  {
    popular: false,
    name: "Boîte Manuelle",
    price: prix.manuelle,
    subPrice: en3x(prix.manuelle),
    features: [
      "20h de conduite",
      "Révision du code de la route offerte (en ligne)",
      "Dates d'examen rapides",
      "Paiement en 3x sans frais via Alma",
      "Accompagnement du début à la fin",
    ],
    cta: "Je réserve — Boîte Manuelle →",
    highlight: false,
  },
  {
    popular: false,
    name: "Formule Accélérée",
    price: prix.accelere,
    subPrice: en3x(prix.accelere),
    features: [
      "Permis en 1 mois chrono",
      "Heures de conduite intensives",
      "Révision du code de la route offerte (en ligne)",
      "Dates d'examen prioritaires",
      "Accompagnement le jour de l'examen",
      "Suivi personnalisé jusqu'au permis",
      "Paiement en 3x sans frais via Alma",
    ],
    cta: "Je réserve — Formule Accélérée →",
    highlight: true,
  },
];
---

<section id="formules">
  <div class="container">

    <div class="formules-header fade-up">
      <span class="section-label">Nos offres</span>
      <h2 class="section-title">Choisis ta <span>formule</span></h2>
      {remise && (
        <p class="promo-banner">🎉 Offre de lancement {ville} : <strong>-{remise}€ sur toutes les formules</strong></p>
      )}
    </div>

    <div class="cards-grid">
      {formules.map((f) => (
        <div class={`formula-card fade-up${f.popular ? ' popular' : ''}${f.highlight ? ' highlight' : ''}`}>
          <div class="formula-header">
            {f.popular && <span class="badge-popular">Le plus populaire</span>}
            {f.highlight && <span class="badge-popular badge-gold">⚡ Permis en 1 mois</span>}
            {!f.popular && !f.highlight && <div style="height:28px;" />}
            <div class="formula-name">{f.name}</div>
            <div class="formula-price-row">
              <span class="formula-price">{f.price}€</span>
              {remise && <s class="formula-old">{f.price + remise}€</s>}
              {remise && <span class="remise-tag">-{remise}€</span>}
            </div>
            <div class="formula-sub-price" set:html={f.subPrice.replace('=', '= <strong>').replace('/mois', '/mois</strong>')} />
          </div>
          <div class="formula-body">
            <ul class="feature-list">
              {f.features.map((feat) => (
                <li><span class="check">✅</span> {feat}</li>
              ))}
            </ul>
            <a class="btn btn-full" href={CALENDLY} target="_blank" rel="noopener noreferrer">
              {f.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  #formules { background: var(--black); }

  .formules-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .formula-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
    position: relative;
  }
  .formula-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--red);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .formula-card:hover { border-color: var(--red); transform: translateY(-6px); box-shadow: 0 16px 48px rgba(232,19,10,0.12); }
  .formula-card:hover::before, .formula-card.popular::before { opacity: 1; }

  .formula-card.highlight {
    border-color: rgba(255, 180, 0, 0.35);
    background: rgba(255, 160, 0, 0.04);
  }
  .formula-card.highlight::before {
    background: linear-gradient(90deg, #e8130a, #ff9500);
    opacity: 1;
  }
  .formula-card.highlight:hover {
    border-color: rgba(255, 160, 0, 0.7);
    box-shadow: 0 16px 48px rgba(255, 140, 0, 0.15);
  }

  .badge-gold {
    background: linear-gradient(90deg, #e8130a, #ff9500) !important;
  }

  .formula-header {
    padding: 32px 28px 24px;
    border-bottom: 1px solid var(--border);
  }

  .badge-popular {
    display: inline-block;
    background: var(--red);
    color: var(--white);
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 100px;
    margin-bottom: 16px;
  }

  .formula-name {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 6px;
  }

  .formula-price {
    font-family: var(--font-title);
    font-weight: 900;
    font-size: 3.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--red);
  }

  .formula-price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
  }

  .formula-old {
    font-family: var(--font-title);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
  }

  .remise-tag {
    padding: 3px 10px;
    border-radius: 100px;
    background: linear-gradient(90deg, #e8130a, #ff9500);
    font-family: var(--font-title);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .promo-banner {
    display: inline-block;
    margin-top: 18px;
    padding: 10px 18px;
    border-radius: 10px;
    background: linear-gradient(90deg, #e8130a, #ff9500);
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .promo-banner strong { font-weight: 800; }

  .formula-sub-price {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 6px;
  }

  .formula-body {
    padding: 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .feature-list {
    list-style: none;
    margin-bottom: 28px;
    flex: 1;
  }
  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 0;
    font-size: 0.97rem;
    border-bottom: 1px solid var(--border);
  }
  .feature-list li:last-child { border-bottom: none; }
  .check { color: var(--red); font-size: 1rem; flex-shrink: 0; margin-top: 2px; }

  .btn-full { width: 100%; justify-content: center; }

  @media (max-width: 1024px) {
    .cards-grid { grid-template-columns: 1fr 1fr; max-width: 860px; }
  }

  @media (max-width: 640px) {
    .cards-grid { grid-template-columns: 1fr; max-width: 480px; }
  }
</style>
